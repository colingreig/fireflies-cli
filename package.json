{
  "name": "fireflies-cli",
  "version": "0.1.0",
  "description": "Agent-native CLI and MCP server for the Fireflies.ai API \u2014 transcripts, meetings, AskFred AI, soundbites, analytics",
  "type": "module",
  "bin": {
    "fireflies": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "dev:mcp": "tsx src/mcp.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@inquirer/prompts": "^8.3.0",
    "commander": "^12.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "fireflies",
    "fireflies-ai",
    "mcp",
    "cli",
    "transcript",
    "meeting",
    "ai-agent",
    "mcp-server"
  ],
  "license": "MIT",
  "author": "Brandon Charleson <b.charleson@lafilm.edu>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bcharleson/fireflies-cli.git"
  },
  "homepage": "https://github.com/bcharleson/fireflies-cli#readme",
  "bugs": {
    "url": "https://github.com/bcharleson/fireflies-cli/issues"
  }
}